#include <stdio.h>
int main()
{
   int col,row,matrix[100][100],i,j;
   printf("Enter the row number ");
   scanf("%d",&row);
   printf("Enter the colom ");
   scanf("%d",&col);

   for(i=0;i<row;i++){
    for(j=0;j<col;j++){
        printf("matrix %d%d ",i,j);
        scanf("%d",&matrix[i][j]);
    }
   }
   for(i=0;i<row;i++){
    for(j=0;j<col;j++){
        printf(" %d ",matrix[i][j]);

        if( j==col-1){
            printf("\n\n");
        }
       
    }
   }
}
