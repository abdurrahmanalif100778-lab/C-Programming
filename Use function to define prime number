#include <stdio.h>
int alif(int n);
int main()
{
    int number;
    printf("Enter the 1st number");
    scanf("%d",&number);
    
    if(alif(number)==1){
        printf("this is prime number");

    }
    else 
    printf("not prime number");

return 0;

}
int alif(int n){
    for(int i=2;i<n;i++){
        if(n%i==0){
            return 0;
        }
    }
    return 1;
}
