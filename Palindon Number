#include <stdio.h>
int main()
{
    int number,rev=0,reminder,original;
    scanf("%d",&number);
    original=number;

    while(number!=0){
        reminder=number%10;
        rev=rev*10+ reminder;
        number/=10;
    }
    if(original==rev){
        printf("palindon number");
    }
    else 
    printf("not palindon massage");
    return 0;
}
